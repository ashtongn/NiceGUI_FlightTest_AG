{
 "format": "dpmg-mission/1",
 "name": "Loopback: nine comm waveforms in turn, TRx1B to TRx1A",
 "notes": "One G40, cable TRx1B to TRx1A through the pad. Nine waveforms one after the other, each keyed for 13 s at TX attenuation 30 dB and decoded by the same radio: FSK, 4FSK, BPSK, QPSK, OQPSK, 8PSK, 16QAM, then QPSK and FSK with rate 1/2 convolutional coding.",
 "authorization": {
  "reference": "BENCH-LOOPBACK",
  "note": "cabled bench loopback: TX jack to RX jack through a pad, no antenna, no amplifier"
 },
 "anchor": {
  "mode": "on_tx"
 },
